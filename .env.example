# Copy this file to .env and fill in the values you need.
# .env is git-ignored — never commit real keys.

# ── Live crypto rates ────────────────────────────────────────────────
# OFF by default. With no key and no backend running, the site shows its
# built-in fallback prices and makes no network calls (keeps the dev
# terminal free of proxy errors).
#
# To switch live rates on:
#   1. add your CoinMarketCap key below
#   2. start the rates backend:  npm run server
#   3. set VITE_ENABLE_LIVE_RATES=true
#   4. restart the dev server (Vite only reads env vars at startup)

# Server-side only — used by server/crypto-rates.js, never sent to the browser.
CMC_API_KEY=

# Client-side flag. Must be exactly "true" to enable live rates.
VITE_ENABLE_LIVE_RATES=false

# Only needed if the rates backend is on a DIFFERENT origin than the site.
# Leave blank to call same-origin /api/crypto-rates (dev uses the Vite proxy).
VITE_API_BASE_URL=

# Port the rates backend listens on (defaults to 5001).
PORT=5001
